# Copy this file to .env and paste your OpenRouter *Management* key below.
# Create one at https://openrouter.ai/settings/management-keys
OPENROUTER_MANAGEMENT_KEY=sk-or-v1-

# Optional: only change this for testing against the mock server.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The command-line script asks for these when they're not set. Set them only
# to skip the questions (e.g. in automation). Key names look like
# US-001-mid-oct-rahul.k@gmail.com
# PROGRAM=swe          # swe | pm-tpm | em | fde
# REGION=US            # US | IND
# COHORT=mid-oct       # free text: early-oct, mid-oct, 2nd-mid-oct, end-oct ...
# CREDIT_LIMIT=2       # USD per key, or "none"; defaults to the program's limit in config.js

# Optional workspace IDs. If not set, the workspace is found by the slug in
# config.js (agentic-ai-swe, agentic-ai-pm-tpm, agentic-ai-em, fde-program).
# OR_WS_SWE=
# OR_WS_PM_TPM=
# OR_WS_EM=
# OR_WS_FDE=

# Web UI port (npm run web)
# PORT=3000

# Google sign-in for the web page. Required on Vercel; optional on your own computer
# (leave all four empty to use the local page without signing in). See README section 14.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=        # 32+ random characters
# ALLOWED_EMAILS=        # comma-separated, only @interviewkickstart.com, e.g. a@interviewkickstart.com,b@interviewkickstart.com
